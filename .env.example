# Copy to .env and fill in. Never commit .env.

# Teslemetry API key (teslemetry.com dashboard)
TESLEMETRY_API_KEY=
# Found by running: TESLEMETRY_API_KEY=... python app/powerwall.py
ENERGY_SITE_ID=

# Hyundai Bluelink login
BLUELINK_USERNAME=
BLUELINK_PASSWORD=
BLUELINK_PIN=
# Only needed if the account has more than one car
BLUELINK_VEHICLE_ID=

# Rule settings (defaults shown)
# MODE=auto
# POWERWALL_SOC_THRESHOLD=35
# POWERWALL_RESUME_MARGIN=5
# SOLAR_THRESHOLD_KW=8
# CAR_TARGET_SOC=80
# CAR_MIN_SOC=20
# START_DELAY_MINUTES=10
# STOP_DELAY_MINUTES=5
# MIN_MINUTES_BETWEEN_COMMANDS=15
# MAX_COMMANDS_PER_DAY=12
# POLL_SECONDS=60
# CAR_REFRESH_MINUTES=5
